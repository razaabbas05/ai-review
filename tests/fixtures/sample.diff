@@ -7,3 +7,17 @@ PAGE_SIZE = 20
 def list_users(conn: sqlite3.Connection):
     """Return every user, oldest first."""
     return conn.execute("SELECT id, email, role FROM users ORDER BY id").fetchall()
+
+
+def search_users(conn: sqlite3.Connection, term: str, page: int = 1):
+    """Admin-only search by email substring, 20 per page, page is 1-based."""
+    if term is None:
+        raise ValueError("term required")
+    offset = page * PAGE_SIZE
+    query = (
+        "SELECT id, email, role FROM users "
+        f"WHERE LOWER(email) LIKE '%{term.lower()}%' "
+        f"ORDER BY id LIMIT {PAGE_SIZE} OFFSET {offset}"
+    )
+    rows = conn.execute(query).fetchall()
+    return {"results": rows, "first_email": rows[0][1]}
